# Apache settings for the static build (Cloudways serves .htaccess).

# 3D / decoder assets
AddType model/gltf-binary .glb
AddType application/wasm .wasm

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm
</IfModule>

<IfModule mod_headers.c>
  # Vite's hashed bundles never change → cache for a year.
  # (FilesMatch sees the file name only, e.g. index-DhvCQ0dp.js.)
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Product photos, models, textures: cache a week.
  <FilesMatch "\.(jpg|jpeg|png|webp|glb|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Always fetch a fresh index.html so new deploys show up.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
